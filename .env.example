# Copie para .env e preencha com as suas credenciais do portal developer.mpesa.vm.co.mz

PORT=3000

# sandbox | live
MPESA_ENV=sandbox

MPESA_API_KEY=sua_api_key_aqui

# Public Key RSA completa (uma linha, sem espaços)
MPESA_PUBLIC_KEY=sua_public_key_aqui

# Código fornecido pela Vodacom no portal
MPESA_SERVICE_PROVIDER_CODE=171717

# Header Origin exigido pela API
MPESA_ORIGIN=developer.mpesa.vm.co.mz

# País/moeda de Moçambique (não alterar)
MPESA_COUNTRY=MOZ
MPESA_CURRENCY=MZN
